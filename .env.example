# Copy to `.env.development`, `.env.production`, etc. and adjust as needed.
# Relative URLs route through the Vite dev proxy defined in vite.config.js.

# Backend REST API base URL (without trailing slash)
VITE_API_BASE_URL=/api

# Request timeout in milliseconds (optional, default 15000)
VITE_API_TIMEOUT=15000

# --- Social login (required for the Google / Facebook buttons to work) ---
# Google OAuth 2.0 Web client id (Token client's client id). Public by nature;
# create one at https://console.cloud.google.com/apis/credentials
# VITE_GOOGLE_CLIENT_ID=xxxx-xxxx.apps.googleusercontent.com

# Facebook App id (https://developers.facebook.com/apps)
# VITE_FACEBOOK_APP_ID=123456789